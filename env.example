# Online production mode required
IMAP_HOST=imap.gmail.com                # or outlook.office365.com / custom.domain.com
IMAP_PORT=993                          # TLS port — default; keep 993
IMAP_USER=you@yourdomain.com            # email address used for login
IMAP_PASSWORD=generated-service-account-token # recommendation: OAuth2 token stored securely (e.g. Vault/Vaultwarden/secrets-manager)
# OR legacy
# IMAP_PASSWORD=plain-text-secret     # NOT recommended in prod pipelines

IMAP_USE_SSL=true                      # true || false (false triggers STARTTLS if server supports)
MAILBOX=INBOX                          # primary folder to operate on
MAX_BODY_CHARS=8000                    # limit plain-body size for safety
# Optional: Debug level
# LOG_LEVEL=DEBUG
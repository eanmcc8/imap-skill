# ============================================================
# imap-skill configuration
# ============================================================
# Copy this file to .env and fill in your values
# Lines starting with # are comments (ignored)
# ============================================================

# --- IMAP Settings (required) ---
IMAP_HOST=imap.web.de # IMAP server hostname (e.g., imap.gmail.com, outlook.office365.com)
IMAP_PORT=993         # IMAP port: 993 (SSL), 143 (STARTTLS)
IMAP_USE_SSL=true     # true=SSL/TLS, false=STARTTLS, auto=993→SSL
IMAP_REQUIRE_ID=false # true ONLY for 126/163 NetEase (RFC 2971 IMAP ID)
IMAP_USER=autopassiv@web.de     # Your email address
IMAP_PASSWORD=Zehnagel+555      # App password / auth code (NOT login password)

# --- SMTP Settings (required for send/reply/forward/draft) ---
# SMTP server hostname (e.g., smtp.gmail.com, smtp.office365.com)
# SMTP port: 465 (SSL), 587 (STARTTLS)
# true=SSL (port 465), false=STARTTLS (port 587)
# SMTP login (usually same as IMAP_USER)
# SMTP password (usually same as IMAP_PASSWORD)

# --- Optional Settings ---
MAX_BODY_CHARS=8000   # Max body chars in fetch_message (truncation limit)
LOG_LEVEL=INFO        # DEBUG, INFO, WARNING, ERROR
IMAP_POOL_SIZE=2      # Connection pool size (concurrent connections)
IMAP_IDLE_TIMEOUT=300 # Idle connection TTL in seconds (5 min)
IMAP_BACKUP_DIR=~/imap_backup   # Offline backup output directory

# --- Preset Examples (uncomment one block) ---
# Gmail:
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USE_SSL=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_SSL=false

# Outlook / Office 365:
# IMAP_HOST=outlook.office365.com
# IMAP_PORT=993
# IMAP_USE_SSL=true
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USE_SSL=false

# QQ Mail:
# IMAP_HOST=imap.qq.com
# IMAP_PORT=993
# IMAP_USE_SSL=true
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USE_SSL=true

# 163 NetEase (requires IMAP ID):
# IMAP_HOST=imap.163.com
# IMAP_PORT=993
# IMAP_USE_SSL=true
# IMAP_REQUIRE_ID=true
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_USE_SSL=true

# 126 NetEase (requires IMAP ID):
# IMAP_HOST=imap.126.com
# IMAP_PORT=993
# IMAP_USE_SSL=true
# IMAP_REQUIRE_ID=true
# SMTP_HOST=smtp.126.com
# SMTP_PORT=465
# SMTP_USE_SSL=true


# Optional: environment variables accepted by ImapClient
# -------------------------------
# IMAP real credentials
# -------------------------------
# IMAP_HOST=imap.gmail.com          # e.g. outlook.office365.com
# IMAP_PORT=993                     # TLS default
# IMAP_USER=you@domain.com
# IMAP_PASSWORD=YOUR_SERVICE_ACCOUNT_PASSWORD   # use OAuth token instead for security
#
# -------------------------------
# OR Oauth2 (preferred)
# -------------------------------
# IMAP_TOKEN=Bearer eyJ...             # 64-char token issued by provider
#
# -------------------------------
# Configurable mailbox name for demo mode
# -------------------------------
# MAILBOX=INBOX
#
# -------------------------------
# Memory safety / pagination limits
# -------------------------------
# MAX_BODY_CHARS=8000                 # truncate bodies past this limit
# SEARCH_LIMIT=20                     # default number of search results
# -------------------------------
# Mocking flags for testing without real server
# -------------------------------
# DUMMY=true                           # if this env var exists, use DummyImapClient instead of real
#```


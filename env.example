IMAP_HOST=imap.gmail.com          # or outlook.office365.com, imap.yourdomain.com
IMAP_PORT=993                    # TLS
IMAP_USER=you@yourdomain.com
IMAP_PASSWORD=app-secret-pass     # generated service account
IMAP_USE_SSL=True                # or False only if you really mean STARTTLS
MAILBOX=INBOX                    # optional default

# Optional: use OAuth2 tokens instead
# IMAP_TOKEN=Bearer eyJ...         # recommended for production

# Optional: limit message size for safety
MAX_BODY_CHARS=10000